{
    "name": "@oliverperzyk/documenting-apps",
    "description": "Solutions for the tasks from school subject related to testing & documenting IT projects.",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "type": "module",
    "scripts": {
        "bundle": "bun scripts/bundle.ts",
        "test:bundle": "bun test scripts/bundle.test.ts",
        "format": "bunx prettier --write . && bun scripts/FormatCpp.ts && bun run format-python",
        "format:check": "bunx prettier --check . && bun scripts/FormatCpp.ts --check && bun run format-python:check",
        "format-cpp": "bun scripts/FormatCpp.ts",
        "format-cpp:check": "bun scripts/FormatCpp.ts --check",
        "format-python": "uvx ruff@0.17.1 format",
        "format-python:check": "uvx ruff@0.17.1 format --check",
        "lint": "bunx eslint . && bun run lint-python",
        "lint:fix": "bunx eslint --fix . && bun run lint-python:fix",
        "lint-python": "uvx ruff@0.17.1 check",
        "lint-python:fix": "uvx ruff@0.17.1 check --fix",
        "prepare": "lefthook install"
    },
    "lint-staged": {
        "**/*.{json,json5,jsonc,md}": [
            "bunx eslint --fix --no-warn-ignored",
            "bunx prettier --write"
        ],
        "**/*.{ts,tsx,yml,yaml}": "bunx prettier --write",
        "**/*.{c,cc,cpp,cxx,h,hh,hpp,hxx}": "bun run format-cpp",
        "**/*.py": [
            "bun run lint-python:fix",
            "bun run format-python"
        ]
    },
    "devDependencies": {
        "@eslint/json": "^2.1.0",
        "@eslint/markdown": "^8.0.3",
        "@types/node": "^26.6.3",
        "@wasm-fmt/clang-format": "^23.1.1",
        "eslint": "^10.11.0",
        "jiti": "^2.7.0",
        "lefthook": "^2.1.14",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9"
    }
}
